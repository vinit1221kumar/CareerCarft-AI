# Shared production references (copy values into each service environment)

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<strong-random-secret>
JWT_EXPIRE=7d

# Public service URLs
GATEWAY_PUBLIC_URL=https://your-gateway-service.onrender.com
AUTH_SERVICE_URL=https://your-auth-service.onrender.com
RESUME_SERVICE_URL=https://your-resume-service.onrender.com
AI_SERVICE_URL=https://your-ai-service.onrender.com
ROADMAP_SERVICE_URL=https://your-roadmap-service.onrender.com
ANALYTICS_SERVICE_URL=https://your-analytics-service.onrender.com

# Frontend
VITE_API_BASE_URL=https://your-gateway-service.onrender.com

# AI/LLM
HUGGINGFACE_API_KEY=<optional>
LLM_API_URL=<provider-endpoint>
LLM_API_KEY=<provider-key>
LLM_MODEL=gpt-3.5-turbo
